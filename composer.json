{
    "name": "alirezabelal/marketplace-demo",
    "type": "project",
    "description": "Commercially reusable Laravel multi-vendor marketplace source; deploying teams own payment/SMS integration, security, and final acceptance testing.",
    "keywords": [
        "laravel",
        "livewire",
        "marketplace",
        "ecommerce"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "artesaos/seotools": "^1.4",
        "consoletvs/charts": "^6.9",
        "cviebrock/eloquent-sluggable": "^13.0",
        "guzzlehttp/guzzle": "^7.9",
        "kavenegar/php": "^1.2",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.8",
        "laravel/jetstream": "^5.5",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.9",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "morilog/jalali": "^3.5",
        "pharaonic/livewire-select2": "^1.2",
        "shetabit/multipay": "^1.9",
        "stevebauman/location": "^7.7",
        "unisharp/laravel-filemanager": "^2.15"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
